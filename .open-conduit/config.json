{
  "version": 1,
  "scopes": [
    {
      "id": "review",
      "name": "review",
      "authorization": {
        "connections": [
          "github-reviewer",
          "posthog"
        ],
        "operations": [
          "read_context",
          "wait",
          "declare_outcome",
          "github.context",
          "github.issue.view",
          "github.pr.list",
          "github.pr.view",
          "github.pr.comment",
          "github.pr.reply",
          "github.pr.review",
          "github.checks",
          "github.attachment.get",
          "github.wait",
          "introspection.report-issue",
          "introspection.correction",
          "introspection.problem",
          "introspection.evidence",
          "introspection.reports",
          "introspection.report.resolve",
          "introspection.notes.resolve",
          "github.issue.list",
          "github.issue.create",
          "github.issue.comment",
          "github.pr.resolve"
        ],
        "read_scopes": []
      },
      "bindings": [
        {
          "name": "triage",
          "executor": "claude-code",
          "requires": {
            "toolbelt": "mcp"
          },
          "operations": [
            "introspection.evidence",
            "introspection.reports",
            "introspection.report.resolve",
            "introspection.notes.resolve",
            "github.issue.list",
            "github.issue.view",
            "github.issue.create",
            "github.issue.comment"
          ],
          "secret_names": [],
          "config": {
            "playbook": "triage-reports",
            "model": "opus",
            "permission_mode": "bypassPermissions"
          }
        }
      ],
      "routes": [
        {
          "name": "triage",
          "handler": "introspection",
          "binding": "triage",
          "active_policy": "queue",
          "config": {
            "work": "triage"
          }
        }
      ]
    },
    {
      "id": "review-open-conduit",
      "name": "review open-conduit/open-conduit",
      "parent": "review",
      "bindings": [
        {
          "name": "reviewer",
          "executor": "claude-code",
          "connection": "github-reviewer",
          "requires": {
            "toolbelt": "mcp",
            "workspace": true,
            "resume": true
          },
          "operations": [
            "read_context",
            "wait",
            "declare_outcome",
            "github.context",
            "github.issue.view",
            "github.pr.list",
            "github.pr.view",
            "github.pr.comment",
            "github.pr.reply",
            "github.pr.resolve",
            "github.pr.review",
            "github.checks",
            "github.attachment.get",
            "github.wait",
            "introspection.report-issue",
            "introspection.correction",
            "introspection.problem"
          ],
          "secret_names": [],
          "config": {
            "playbook": "review-pr",
            "plugin_dir": "plugin",
            "model": "opus",
            "permission_mode": "bypassPermissions"
          },
          "resource": {
            "provider": "git",
            "config": {
              "checkout": "/Users/alexyoung/Code/open-conduit"
            }
          }
        }
      ],
      "routes": [
        {
          "name": "pull-requests",
          "handler": "github",
          "binding": "reviewer",
          "active_policy": "queue",
          "config": {
            "claim": "pull_requests"
          }
        }
      ],
      "extensions": [
        {
          "name": "open-conduit-prs",
          "type": "github",
          "connection": "github-reviewer",
          "secret_names": [
            "github_webhook"
          ],
          "config": {
            "namespace": "github/github.com/open-conduit/open-conduit/review",
            "scope": "review-open-conduit",
            "repo": "open-conduit/open-conduit",
            "track_issues": false,
            "projection": {
              "disabled": true
            },
            "track_pull_requests": true,
            "webhook_secret": "github_webhook",
            "manage_webhook": true,
            "admit": {
              "authors": [
                "OWNER",
                "MEMBER",
                "COLLABORATOR",
                "CONTRIBUTOR"
              ]
            }
          }
        },
        {
          "name": "introspection",
          "type": "introspection",
          "secret_names": [],
          "config": {
            "triage": {
              "cron": "0 9 * * *",
              "time_zone": "Europe/London",
              "file_issues": true
            }
          }
        }
      ]
    },
